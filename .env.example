# Example environment configuration.
# Copy this file to .env and fill in your own values.
# Never commit real secrets to version control.

# Expo public variables (safe to expose)
EXPO_PUBLIC_API_URL=http://localhost:4000

# Backend server configuration
PORT=4000
MONGODB_URI=mongodb://localhost:27017/campus_student
JWT_SECRET=your_jwt_secret_change_in_production
CORS_ORIGIN=*

# Example: Add your own private variables here (NOT prefixed with EXPO_PUBLIC_)
# DATABASE_URL=
# JWT_SECRET=

# Note: expo-secure-store and AsyncStorage handle secrets at runtime,
# not via environment variables at build time.
